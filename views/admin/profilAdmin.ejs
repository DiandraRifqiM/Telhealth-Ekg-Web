<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style/adminDashboard.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    />
  </head>
  <body class="bg-light">
    <div class="main-container">
      <!-- SIDEBAR DESKTOP -->
      <div
        class="sidebar d-none d-md-flex flex-column p-3 bg-success text-white"
      >
        <a
          href="/adminDashboard"
          class="d-flex align-items-center mb-3 text-decoration-none text-white px-2"
        >
          <i class="bi bi-shield-lock-fill fs-3 me-2"></i>
          <span class="fs-5 fw-bold">Admin Dashboard</span>
        </a>
        <hr class="sidebar-divider" />
        <ul class="nav nav-pills flex-column mb-auto">
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/pasien"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/dokter"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-heart-pulse-fill me-3 fs-5"></i> Daftar Dokter
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/admin"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-person-badge-fill me-3 fs-5"></i> Daftar Admin
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/addUser"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-person-plus-fill me-3 fs-5"></i> Tambah Pengguna
            </a>
          </li>
        </ul>
        <hr class="sidebar-divider" />
        <div class="pb-2">
          <a
            href="/adminDashboard/profile"
            class="sidebar-profile-link text-decoration-none text-white"
          >
            <div
              class="profile-avatar bg-white text-success rounded-circle me-2 d-inline-flex align-items-center justify-content-center"
              style="width: 40px; height: 40px"
            >
              <i class="bi bi-person-badge-fill fs-5"></i>
            </div>
            <div
              class="text-truncate d-inline-block align-middle"
              style="max-width: 170px"
            >
              <div class="fw-bold small text-white text-truncate">
                <%= userData.fullname %>
              </div>
              <div class="profile-email text-white-50 small text-truncate">
                Profil Saya
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- SIDEBAR MOBILE -->
      <div
        class="offcanvas offcanvas-start bg-success text-white sidebar-mobile"
        tabindex="-1"
        id="mobileSidebar"
      >
        <div
          class="offcanvas-header border-bottom border-light border-opacity-25 px-4 pt-4"
        >
          <h5 class="offcanvas-title fw-bold">
            <i class="bi bi-shield-lock-fill me-2"></i> Admin Dashboard
          </h5>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="offcanvas"
          ></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
          <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard"
                class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
              >
                <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/pasien"
                class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
              >
                <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/dokter"
                class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
              >
                <i class="bi bi-heart-pulse-fill me-3 fs-5"></i> Daftar Dokter
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/admin"
                class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
              >
                <i class="bi bi-person-badge-fill me-3 fs-5"></i> Daftar Admin
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/addUser"
                class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
              >
                <i class="bi bi-person-plus-fill me-3 fs-5"></i> Tambah Pengguna
              </a>
            </li>
          </ul>
          <hr class="border-light border-opacity-25" />
          <div class="pb-2">
            <a
              href="/adminDashboard/profile"
              class="sidebar-profile-link text-decoration-none text-white"
            >
              <div
                class="profile-avatar bg-white text-success rounded-circle me-2 d-inline-flex align-items-center justify-content-center"
                style="width: 40px; height: 40px"
              >
                <i class="bi bi-person-badge-fill fs-5"></i>
              </div>
              <div
                class="text-truncate d-inline-block align-middle"
                style="max-width: 170px"
              >
                <div class="fw-bold small text-white text-truncate">
                  <%= userData.fullname %>
                </div>
                <div class="profile-email text-white-50 small text-truncate">
                  Profil Saya
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- KONTEN UTAMA -->
      <div class="main-content bg-light">
        <!-- TOPBAR -->
        <div
          class="topbar bg-white border-bottom px-3 px-md-4 py-3 d-flex justify-content-between align-items-center shadow-sm"
        >
          <div class="d-flex align-items-center">
            <button
              class="btn btn-outline-success d-md-none me-3"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#mobileSidebar"
            >
              <i class="bi bi-list fs-5"></i>
            </button>
            <h4 class="fw-bold text-dark m-0 fs-5 fs-md-4">Profil Admin</h4>
          </div>
          <div>
            <form action="/logout" method="post" class="m-0">
              <button
                type="submit"
                class="btn btn-outline-danger btn-sm fw-semibold d-flex align-items-center"
              >
                <i class="bi bi-box-arrow-right me-2"></i> Logout
              </button>
            </form>
          </div>
        </div>

        <!-- ISI PROFIL -->
        <div class="form-container p-3 p-md-4">
          <div class="mb-3 w-100" style="max-width: 900px">
            <a
              href="/adminDashboard"
              class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold d-inline-flex align-items-center rounded-3 text-decoration-none"
            >
              <i class="bi bi-arrow-left me-2"></i> Kembali
            </a>
          </div>

          <div
            class="row g-4 w-100 justify-content-center"
            style="max-width: 900px"
          >
            <!-- CARD UTAMA KIRI -->
            <div class="col-12 col-lg-4">
              <div
                class="card border-0 shadow-sm rounded-4 p-4 text-center h-100"
              >
                <div class="d-flex justify-content-center mb-3">
                  <div
                    class="profile-avatar-large bg-success bg-opacity-10 text-success"
                  >
                    <i class="bi bi-shield-lock-fill fs-1"></i>
                  </div>
                </div>
                <h5 class="fw-bold text-dark mb-3"><%= userData.fullname %></h5>
                <hr class="text-muted opacity-25" />
                <div class="text-start">
                  <span class="text-muted small d-block">Status Akun</span>
                  <span
                    class="badge bg-success bg-opacity-10 text-success fw-semibold mt-1 px-3 py-2"
                    >Administrator</span
                  >
                </div>
              </div>
            </div>

            <!-- CARD DETAIL INFORMASI ADMIN -->
            <div class="col-12 col-lg-8">
              <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                  <i class="bi bi-card-heading text-success me-2"></i> Detail
                  Informasi Admin
                </h5>

                <div class="row g-3">
                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Nama Lengkap</span
                      >
                      <strong class="text-dark"
                        ><%= userData.fullname %></strong
                      >
                    </div>
                  </div>

                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Username / ID</span
                      >
                      <strong class="text-dark"
                        ><%= userData.username %></strong
                      >
                    </div>
                  </div>

                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Tanggal Lahir</span
                      >
                      <strong class="text-dark"
                        ><%= userData.birthdate || userData.dob || '-'
                        %></strong
                      >
                    </div>
                  </div>

                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Jenis Kelamin</span
                      >
                      <strong class="text-dark"
                        ><%= userData.gender || '-' %></strong
                      >
                    </div>
                  </div>

                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Golongan Darah</span
                      >
                      <strong class="text-dark"
                        ><%= userData.bloodType || '-' %></strong
                      >
                    </div>
                  </div>

                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Nomor Telepon / WA</span
                      >
                      <strong class="text-dark"
                        ><%= userData.phone || '-' %></strong
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
