<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard - Telehealth EKG</title>
    <link rel="stylesheet" href="/style/adminDashboard.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    />
  </head>
  <body class="bg-light">
    <div class="d-flex min-vh-100 overflow-hidden">
      <!-- // SIDEBAR DESKTOP -->
      <div
        class="sidebar d-none d-md-flex flex-column p-3 bg-success text-white"
      >
        <a
          href="/adminDashboard"
          class="d-flex align-items-center mb-3 text-decoration-none text-white px-2"
        >
          <i class="bi bi-shield-lock-fill fs-3 me-2"></i>
          <span class="fs-5 fw-bold">Admin Dashboard</span>
        </a>
        <hr class="sidebar-divider" />
        <ul class="nav nav-pills flex-column mb-auto">
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard"
              class="nav-link rounded-3 py-2 px-3 fw-semibold <%= locals.activeTab === 'dashboard' ? 'active' : 'text-white' %>"
            >
              <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/pasien"
              class="nav-link rounded-3 py-2 px-3 fw-semibold <%= locals.activeTab === 'pasien' ? 'active' : 'text-white' %>"
            >
              <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/dokter"
              class="nav-link rounded-3 py-2 px-3 fw-semibold <%= locals.activeTab === 'dokter' ? 'active' : 'text-white' %>"
            >
              <i class="bi bi-heart-pulse-fill me-3 fs-5"></i> Daftar Dokter
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/admin"
              class="nav-link rounded-3 py-2 px-3 fw-semibold <%= locals.activeTab === 'admin' ? 'active' : 'text-white' %>"
            >
              <i class="bi bi-person-badge-fill me-3 fs-5"></i> Daftar Admin
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/addUser"
              class="nav-link rounded-3 py-2 px-3 fw-semibold <%= locals.activeTab === 'addUser' ? 'active' : 'text-white' %>"
            >
              <i class="bi bi-person-plus-fill me-3 fs-5"></i> Tambah Pengguna
            </a>
          </li>
        </ul>
        <hr class="sidebar-divider" />
        <div class="user-profile d-flex align-items-center px-2">
          <div class="profile-avatar bg-white text-success rounded-circle me-2">
            <i class="bi bi-person-badge-fill fs-5"></i>
          </div>
          <div class="text-truncate">
            <div class="fw-bold small text-white text-truncate">
              <%= locals.userData ? userData.fullname : 'Admin' %>
            </div>
            <div class="profile-email text-white-50 small text-truncate">
              <%= locals.userData ? userData.username : 'admin' %>
            </div>
          </div>
        </div>
      </div>

      <!-- // SIDEBAR MOBILE (OFFCANVAS) -->
      <div
        class="offcanvas offcanvas-start bg-success text-white sidebar-mobile"
        tabindex="-1"
        id="mobileSidebar"
      >
        <div
          class="offcanvas-header border-bottom border-light border-opacity-25 px-4 pt-4"
        >
          <h5 class="offcanvas-title fw-bold">
            <i class="bi bi-shield-lock-fill me-2"></i> Admin Dashboard
          </h5>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="offcanvas"
          ></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
          <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard"
                class="nav-link rounded-3 py-2 px-3 fw-semibold <%= locals.activeTab === 'dashboard' ? 'active' : 'text-white' %>"
              >
                <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/pasien"
                class="nav-link rounded-3 py-2 px-3 fw-semibold <%= locals.activeTab === 'pasien' ? 'active' : 'text-white' %>"
              >
                <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/dokter"
                class="nav-link rounded-3 py-2 px-3 fw-semibold <%= locals.activeTab === 'dokter' ? 'active' : 'text-white' %>"
              >
                <i class="bi bi-heart-pulse-fill me-3 fs-5"></i> Daftar Dokter
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/admin"
                class="nav-link rounded-3 py-2 px-3 fw-semibold <%= locals.activeTab === 'admin' ? 'active' : 'text-white' %>"
              >
                <i class="bi bi-person-badge-fill me-3 fs-5"></i> Daftar Admin
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/addUser"
                class="nav-link rounded-3 py-2 px-3 fw-semibold <%= locals.activeTab === 'addUser' ? 'active' : 'text-white' %>"
              >
                <i class="bi bi-person-plus-fill me-3 fs-5"></i> Tambah Pengguna
              </a>
            </li>
          </ul>
          <hr class="border-light border-opacity-25" />
          <div class="user-profile d-flex align-items-center px-2">
            <div
              class="profile-avatar bg-white text-success rounded-circle me-2"
            >
              <i class="bi bi-person-badge-fill fs-5"></i>
            </div>
            <div class="text-truncate">
              <div class="fw-bold small text-white text-truncate">
                <%= locals.userData ? userData.fullname : 'Admin' %>
              </div>
              <div class="profile-email text-white-50 small text-truncate">
                <%= locals.userData ? userData.username : 'admin' %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- // KONTEN UTAMA -->
      <div class="flex-grow-1 bg-light d-flex flex-column h-100 overflow-auto">
        <div
          class="bg-white border-bottom px-3 px-md-4 py-3 d-flex justify-content-between align-items-center shadow-sm"
        >
          <div class="d-flex align-items-center">
            <button
              class="btn btn-outline-success d-md-none me-3"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#mobileSidebar"
            >
              <i class="bi bi-list fs-5"></i>
            </button>
            <h4 class="fw-bold text-dark m-0 fs-5 fs-md-4">Dashboard Admin</h4>
          </div>
          <div>
            <form action="/logout" method="POST" class="m-0">
              <button
                type="submit"
                class="btn btn-outline-danger btn-sm fw-semibold d-flex align-items-center"
              >
                <i class="bi bi-box-arrow-right me-2"></i> Logout
              </button>
            </form>
          </div>
        </div>

        <!-- // 3 Card Kotak Statistik Dummy -->
        <div class="p-3 p-md-4 flex-grow-1">
          <div class="row g-3 g-md-4">
            <div class="col-12 col-sm-6 col-md-4">
              <div
                class="card bg-primary text-white border-0 shadow-sm rounded-4 p-3"
              >
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <h6 class="text-uppercase fw-semibold small mb-1">
                      Total Pasien
                    </h6>
                    <h2 class="fw-bold mb-0">12</h2>
                  </div>
                  <div class="fs-1 opacity-50">
                    <i class="bi bi-people-fill"></i>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
              <div
                class="card bg-success text-white border-0 shadow-sm rounded-4 p-3"
              >
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <h6 class="text-uppercase fw-semibold small mb-1">
                      Total Dokter
                    </h6>
                    <h2 class="fw-bold mb-0">4</h2>
                  </div>
                  <div class="fs-1 opacity-50">
                    <i class="bi bi-heart-pulse-fill"></i>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-12 col-sm-12 col-md-4">
              <div
                class="card bg-dark text-white border-0 shadow-sm rounded-4 p-3"
              >
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <h6 class="text-uppercase fw-semibold small mb-1">
                      Total Admin
                    </h6>
                    <h2 class="fw-bold mb-0">2</h2>
                  </div>
                  <div class="fs-1 opacity-50">
                    <i class="bi bi-shield-lock-fill"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
