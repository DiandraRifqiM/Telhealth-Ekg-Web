<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Detail Pengguna - Admin Dashboard</title>
    <link rel="stylesheet" href="/style/adminDashboard.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    />
  </head>
  <body class="bg-light">
    <div class="d-flex min-vh-100 overflow-hidden">
      <!-- SIDEBAR DESKTOP -->
      <div
        class="sidebar d-none d-md-flex flex-column p-3 bg-success text-white"
      >
        <a
          href="/adminDashboard"
          class="d-flex align-items-center mb-3 text-decoration-none text-white px-2"
        >
          <i class="bi bi-shield-lock-fill fs-3 me-2"></i>
          <span class="fs-5 fw-bold">Admin Dashboard</span>
        </a>
        <hr class="sidebar-divider" />
        <ul class="nav nav-pills flex-column mb-auto">
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard"
              class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
            >
              <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/pasien"
              class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
            >
              <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/dokter"
              class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
            >
              <i class="bi bi-heart-pulse-fill me-3 fs-5"></i> Daftar Dokter
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/admin"
              class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
            >
              <i class="bi bi-person-badge-fill me-3 fs-5"></i> Daftar Admin
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/addUser"
              class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
            >
              <i class="bi bi-person-plus-fill me-3 fs-5"></i> Tambah Pengguna
            </a>
          </li>
        </ul>
        <hr class="sidebar-divider" />
        <div>
          <a href="/admin/profile" class="sidebar-profile-link">
            <div
              class="profile-avatar bg-white text-success rounded-circle me-2"
            >
              <i class="bi bi-person-badge-fill fs-5"></i>
            </div>
            <div class="text-truncate">
              <div class="fw-bold small text-white text-truncate">
                <%= locals.userData ? userData.fullname : 'Admin' %>
              </div>
              <div class="profile-email text-white-50 small text-truncate">
                <%= locals.userData ? userData.username : 'admin' %>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- SIDEBAR MOBILE (OFFCANVAS DENGAN BURGER MENU) -->
      <div
        class="sidebar-mobile offcanvas offcanvas-start bg-success text-white"
        tabindex="-1"
        id="mobileSidebar"
      >
        <div
          class="offcanvas-header border-bottom border-light border-opacity-25 px-4 pt-4"
        >
          <h5 class="offcanvas-title fw-bold">
            <i class="bi bi-shield-lock-fill me-2"></i> Admin Dashboard
          </h5>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="offcanvas"
          ></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
          <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard"
                class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
              >
                <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/pasien"
                class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
              >
                <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/dokter"
                class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
              >
                <i class="bi bi-heart-pulse-fill me-3 fs-5"></i> Daftar Dokter
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/admin"
                class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
              >
                <i class="bi bi-person-badge-fill me-3 fs-5"></i> Daftar Admin
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/addUser"
                class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
              >
                <i class="bi bi-person-plus-fill me-3 fs-5"></i> Tambah Pengguna
              </a>
            </li>
          </ul>
          <hr class="border-light border-opacity-25" />
          <div>
            <a href="/admin/profile" class="sidebar-profile-link">
              <div
                class="profile-avatar bg-white text-success rounded-circle me-2"
              >
                <i class="bi bi-person-badge-fill fs-5"></i>
              </div>
              <div class="text-truncate">
                <div class="fw-bold small text-white text-truncate">
                  <%= locals.userData ? userData.fullname : 'Admin' %>
                </div>
                <div class="profile-email text-white-50 small text-truncate">
                  <%= locals.userData ? userData.username : 'admin' %>
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- KONTEN UTAMA -->
      <div class="flex-grow-1 bg-light d-flex flex-column h-100 overflow-auto">
        <div
          class="bg-white border-bottom px-3 px-md-4 py-3 d-flex justify-content-between align-items-center shadow-sm"
        >
          <div class="d-flex align-items-center">
            <!-- Tombol Burger Menu untuk Mobile -->
            <button
              class="btn btn-outline-success d-md-none me-3"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#mobileSidebar"
            >
              <i class="bi bi-list fs-5"></i>
            </button>
            <h4 class="fw-bold text-dark m-0 fs-5 fs-md-4">Detail Pengguna</h4>
          </div>
          <div>
            <form action="/logout" method="POST" class="m-0">
              <button
                type="submit"
                class="btn btn-outline-danger btn-sm fw-semibold d-flex align-items-center"
              >
                <i class="bi bi-box-arrow-right me-2"></i> Logout
              </button>
            </form>
          </div>
        </div>

        <div
          class="p-3 p-md-4 flex-grow-1 d-flex flex-column align-items-center form-container-scroll"
        >
          <div
            class="card border-0 shadow-sm rounded-4 p-4 w-100 mb-4"
            style="max-width: 600px"
          >
            <!-- Tombol Kembali -->
            <div class="mb-3">
              <a
                href="javascript:history.back()"
                class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold d-inline-flex align-items-center rounded-3 text-decoration-none"
              >
                <i class="bi bi-arrow-left me-2"></i> Kembali
              </a>
            </div>

            <div
              class="mb-4 d-flex justify-content-between align-items-center border-bottom pb-3"
            >
              <div>
                <h5 class="fw-bold text-dark mb-1 fs-5">
                  Biodata & Informasi Akun
                </h5>
                <p class="text-muted small mb-0">
                  Melihat informasi detail akun pengguna di dalam sistem.
                </p>
              </div>
              <span
                class="badge bg-success text-white text-uppercase px-3 py-2"
              >
                <%= targetUser.role %>
              </span>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted"
                >ID Pengguna (System)</label
              >
              <input
                type="text"
                class="form-control bg-light"
                value="<%= targetUser.id || targetUser.userId %>"
                readonly
              />
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted"
                >Username</label
              >
              <input
                type="text"
                class="form-control bg-light"
                value="<%= targetUser.username %>"
                readonly
              />
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted"
                >Nama Lengkap</label
              >
              <input
                type="text"
                class="form-control bg-light"
                value="<%= targetUser.fullname %>"
                readonly
              />
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted"
                >Tanggal Lahir</label
              >
              <input
                type="date"
                class="form-control bg-light"
                value="<%= targetUser.dob %>"
                readonly
              />
            </div>

            <!-- Password Read-Only dengan Ikon Mata -->
            <div class="mb-3">
              <label class="form-label fw-semibold small text-muted"
                >Password Akun</label
              >
              <div class="input-group">
                <input
                  type="password"
                  class="form-control bg-light"
                  id="userPassword"
                  value="<%= targetUser.plainPassword || targetUser.password || '' %>"
                  readonly
                />
                <button
                  class="btn btn-outline-secondary"
                  type="button"
                  onclick="togglePassword()"
                >
                  <i class="bi bi-eye-slash" id="eyeIcon"></i>
                </button>
              </div>
              <div class="form-text text-muted small">
                *Klik ikon mata di samping untuk melihat password akun ini.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Script untuk Toggle Show/Hide Password -->
    <script>
      function togglePassword() {
        const pwdInput = document.getElementById("userPassword");
        const eye = document.getElementById("eyeIcon");
        if (pwdInput.type === "password") {
          pwdInput.type = "text";
          eye.classList.remove("bi-eye-slash");
          eye.classList.add("bi-eye");
        } else {
          pwdInput.type = "password";
          eye.classList.remove("bi-eye");
          eye.classList.add("bi-eye-slash");
        }
      }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
