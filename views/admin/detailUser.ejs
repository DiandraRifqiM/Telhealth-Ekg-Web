<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>

    <link rel="stylesheet" href="/style/adminDashboard.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    />
  </head>
  <body class="bg-light">
    <div class="main-container">
      <!-- SIDEBAR DESKTOP -->
      <div
        class="sidebar d-none d-md-flex flex-column p-3 bg-success text-white"
      >
        <a
          href="/adminDashboard"
          class="d-flex align-items-center mb-3 text-decoration-none text-white px-2"
        >
          <i class="bi bi-shield-lock-fill fs-3 me-2"></i>
          <span class="fs-5 fw-bold">Admin Dashboard</span>
        </a>
        <hr class="sidebar-divider" />
        <ul class="nav nav-pills flex-column mb-auto">
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/pasien"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/dokter"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-heart-pulse-fill me-3 fs-5"></i> Daftar Dokter
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/admin"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-person-badge-fill me-3 fs-5"></i> Daftar Admin
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/addUser"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-person-plus-fill me-3 fs-5"></i> Tambah Pengguna
            </a>
          </li>
        </ul>
        <hr class="sidebar-divider" />
        <div>
          <a href="/admin/profile" class="sidebar-profile-link text-decoration-none text-white">
            <div
              class="profile-avatar bg-white text-success rounded-circle me-2 d-inline-flex align-items-center justify-content-center"
              style="width: 40px; height: 40px;"
            >
              <i class="bi bi-person-badge-fill fs-5"></i>
            </div>
            <div class="text-truncate d-inline-block align-middle" style="max-width: 170px;">
              <div class="fw-bold small text-white text-truncate">
                <%= locals.userData ? userData.fullname : 'Admin' %>
              </div>
              <div class="profile-email text-white-50 small text-truncate">
                <%= locals.userData ? userData.username : 'admin' %>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- SIDEBAR MOBILE -->
      <div
        class="offcanvas offcanvas-start bg-success text-white sidebar-mobile"
        tabindex="-1"
        id="mobileSidebar"
      >
        <div
          class="offcanvas-header border-bottom border-light border-opacity-25 px-4 pt-4"
        >
          <h5 class="offcanvas-title fw-bold">
            <i class="bi bi-shield-lock-fill me-2"></i> Admin Dashboard
          </h5>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="offcanvas"
          ></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
          <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard"
                class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
              >
                <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/pasien"
                class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
              >
                <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/dokter"
                class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
              >
                <i class="bi bi-heart-pulse-fill me-3 fs-5"></i> Daftar Dokter
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/admin"
                class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
              >
                <i class="bi bi-person-badge-fill me-3 fs-5"></i> Daftar Admin
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/addUser"
                class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
              >
                <i class="bi bi-person-plus-fill me-3 fs-5"></i> Tambah Pengguna
              </a>
            </li>
          </ul>
          <hr class="border-light border-opacity-25" />
          <div>
            <a href="/admin/profile" class="sidebar-profile-link text-decoration-none text-white">
              <div
                class="profile-avatar bg-white text-success rounded-circle me-2 d-inline-flex align-items-center justify-content-center"
                style="width: 40px; height: 40px;"
              >
                <i class="bi bi-person-badge-fill fs-5"></i>
              </div>
              <div class="text-truncate d-inline-block align-middle" style="max-width: 170px;">
                <div class="fw-bold small text-white text-truncate">
                  <%= locals.userData ? userData.fullname : 'Admin' %>
                </div>
                <div class="profile-email text-white-50 small text-truncate">
                  <%= locals.userData ? userData.username : 'admin' %>
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- KONTEN UTAMA -->
      <div class="main-content bg-light">
        <!-- TOPBAR -->
        <div
          class="topbar bg-white border-bottom px-3 px-md-4 py-3 d-flex justify-content-between align-items-center shadow-sm"
        >
          <div class="d-flex align-items-center">
            <button
              class="btn btn-outline-success d-md-none me-3"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#mobileSidebar"
            >
              <i class="bi bi-list fs-5"></i>
            </button>
            <h4 class="fw-bold text-dark m-0 fs-5 fs-md-4">Detail & Edit Pengguna</h4>
          </div>
          <div>
            <form action="/logout" method="POST" class="m-0">
              <button
                type="submit"
                class="btn btn-outline-danger btn-sm fw-semibold d-flex align-items-center"
              >
                <i class="bi bi-box-arrow-right me-2"></i> Logout
              </button>
            </form>
          </div>
        </div>

        <!-- ISI KONTEN (BISA DI-SCROLL) -->
        <div class="form-container p-3 p-md-4">
          <!-- TOMBOL KEMBALI -->
          <div class="mb-3 w-100" style="max-width: 950px;">
            <a
              href="javascript:history.back()"
              class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold d-inline-flex align-items-center rounded-3 text-decoration-none"
            >
              <i class="bi bi-arrow-left me-2"></i> Kembali
            </a>
          </div>

          <!-- FORM UPDATE PENGGUNA -->
          <form action="/admin/user/update/<%= targetUser._id %>" method="POST" class="w-100" style="max-width: 950px;">
            <div class="row g-4 justify-content-center">
              
              <!-- CARD KIRI (AVATAR & STATUS) -->
              <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">
                  <div class="d-flex justify-content-center mb-3">
                    <div class="profile-avatar-large bg-success bg-opacity-10 text-success">
                      <i class="bi bi-person-fill fs-1"></i>
                    </div>
                  </div>
                  <h5 class="fw-bold text-dark mb-1"><%= targetUser.fullname %></h5>
                  <span class="text-muted small mb-3">@<%= targetUser.username %></span>
                  
                  <hr class="text-muted opacity-25" />
                  
                  <div class="text-start mb-3">
                    <span class="text-muted small d-block">Role Pengguna</span>
                    <span class="badge bg-success bg-opacity-10 text-success fw-semibold mt-1 px-3 py-2 text-uppercase">
                      <%= targetUser.role %>
                    </span>
                  </div>

                  <div class="text-start">
                    <span class="text-muted small d-block">ID Sistem</span>
                    <small class="text-muted text-break"><%= targetUser._id %></small>
                  </div>
                </div>
              </div>

              <!-- CARD KANAN (DETAIL & FORM INPUT UPDATE) -->
              <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                  <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                    <i class="bi bi-pencil-square text-success me-2"></i> Biodata & Informasi Akun
                  </h5>

                  <div class="row g-3">
                    <!-- Nama Lengkap -->
                    <div class="col-12">
                      <label for="fullname" class="form-label fw-semibold small">Nama Lengkap</label>
                      <input
                        type="text"
                        class="form-control"
                        id="fullname"
                        name="fullname"
                        value="<%= targetUser.fullname %>"
                        required
                      />
                    </div>

                    <!-- Username -->
                    <div class="col-12 col-md-6">
                      <label for="username" class="form-label fw-semibold small">Username</label>
                      <input
                        type="text"
                        class="form-control"
                        id="username"
                        name="username"
                        value="<%= targetUser.username %>"
                        required
                      />
                    </div>

                    <!-- Tanggal Lahir -->
                    <div class="col-12 col-md-6">
                      <label for="dob" class="form-label fw-semibold small">Tanggal Lahir</label>
                      <input
                        type="date"
                        class="form-control"
                        id="dob"
                        name="dob"
                        value="<%= targetUser.dob || targetUser.birthdate || '' %>"
                        required
                      />
                    </div>

                    <!-- Jenis Kelamin -->
                    <div class="col-12 col-md-6">
                      <label for="gender" class="form-label fw-semibold small">Jenis Kelamin</label>
                      <select class="form-select" id="gender" name="gender" required>
                        <option value="Laki-laki" <%= targetUser.gender === 'Laki-laki' ? 'selected' : '' %>>Laki-laki</option>
                        <option value="Perempuan" <%= targetUser.gender === 'Perempuan' ? 'selected' : '' %>>Perempuan</option>
                      </select>
                    </div>

                    <!-- Golongan Darah -->
                    <div class="col-12 col-md-6">
                      <label for="bloodType" class="form-label fw-semibold small">Golongan Darah</label>
                      <select class="form-select" id="bloodType" name="bloodType" required>
                        <option value="A" <%= targetUser.bloodType === 'A' ? 'selected' : '' %>>A</option>
                        <option value="B" <%= targetUser.bloodType === 'B' ? 'selected' : '' %>>B</option>
                        <option value="AB" <%= targetUser.bloodType === 'AB' ? 'selected' : '' %>>AB</option>
                        <option value="O" <%= targetUser.bloodType === 'O' ? 'selected' : '' %>>O</option>
                      </select>
                    </div>

                    <!-- Nomor Telepon / WA -->
                    <div class="col-12 col-md-6">
                      <label for="phone" class="form-label fw-semibold small">Nomor Telepon / WA</label>
                      <input
                        type="text"
                        class="form-control"
                        id="phone"
                        name="phone"
                        value="<%= targetUser.phone || '' %>"
                        placeholder="Contoh: 081234567890"
                        required
                      />
                    </div>

                    <!-- Role / Peran -->
                    <div class="col-12 col-md-6">
                      <label for="role" class="form-label fw-semibold small">Peran (Role)</label>
                      <select class="form-select" id="role" name="role" required>
                        <option value="pasien" <%= targetUser.role === 'pasien' ? 'selected' : '' %>>Pasien</option>
                        <option value="dokter" <%= targetUser.role === 'dokter' ? 'selected' : '' %>>Dokter</option>
                        <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
                      </select>
                    </div>

                    <!-- Password Akun -->
                    <div class="col-12">
                      <label for="password" class="form-label fw-semibold small">Password Baru (Opsional)</label>
                      <input
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        placeholder="Kosongkan jika tidak ingin mengubah password"
                      />
                      <div class="form-text text-muted small">Biarkan kosong jika password tidak ingin diganti.</div>
                    </div>
                  </div>

                  <!-- TOMBOL UPDATE -->
                  <div class="d-flex justify-content-end gap-2 pt-4 mt-4 border-top">
                    <a
                      href="javascript:history.back()"
                      class="btn btn-outline-secondary btn-sm fw-semibold px-4"
                    >
                      Batal
                    </a>
                    <button
                      type="submit"
                      class="btn btn-success btn-sm fw-semibold px-4"
                    >
                      <i class="bi bi-save-fill me-1"></i> Update Perubahan
                    </button>
                  </div>
                </div>
              </div>

            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>