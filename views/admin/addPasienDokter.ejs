<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <!-- CSS Utama Dashboard & CSS Spesifik Halaman Ini -->
    <link rel="stylesheet" href="/style/adminDashboard.css" />
    <link rel="stylesheet" href="/style/addPasienDokter.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    />
  </head>
  <body class="bg-light">
    <div class="d-flex min-vh-100 overflow-hidden">
      <!-- SIDEBAR DESKTOP -->
      <div
        class="sidebar d-none d-md-flex flex-column p-3 bg-success text-white"
      >
        <a
          href="/adminDashboard"
          class="d-flex align-items-center mb-3 text-decoration-none text-white px-2"
        >
          <i class="bi bi-shield-lock-fill fs-3 me-2"></i>
          <span class="fs-5 fw-bold">Admin Dashboard</span>
        </a>
        <hr class="sidebar-divider" />
        <ul class="nav nav-pills flex-column mb-auto">
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard"
              class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
            >
              <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/pasien"
              class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
            >
              <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/dokter"
              class="nav-link active rounded-3 py-2 px-3 fw-semibold text-white"
            >
              <i class="bi bi-heart-pulse-fill me-3 fs-5"></i> Daftar Dokter
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/admin"
              class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
            >
              <i class="bi bi-person-badge-fill me-3 fs-5"></i> Daftar Admin
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard/addUser"
              class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
            >
              <i class="bi bi-person-plus-fill me-3 fs-5"></i> Tambah Pengguna
            </a>
          </li>
        </ul>
        <hr class="sidebar-divider" />
        <div>
          <a href="/adminDashboard/profile" class="sidebar-profile-link">
            <div
              class="profile-avatar bg-white text-success rounded-circle me-2"
            >
              <i class="bi bi-person-badge-fill fs-5"></i>
            </div>
            <div class="text-truncate">
              <div class="fw-bold small text-white text-truncate">
                <%= locals.userData ? userData.fullname : 'Admin' %>
              </div>
              <div class="profile-email text-white-50 small text-truncate">
                <%= locals.userData ? userData.username : 'admin' %>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- SIDEBAR MOBILE (OFFCANVAS) -->
      <div
        class="sidebar-mobile offcanvas offcanvas-start bg-success text-white"
        tabindex="-1"
        id="mobileSidebar"
      >
        <div
          class="offcanvas-header border-bottom border-light border-opacity-25 px-4 pt-4"
        >
          <h5 class="offcanvas-title fw-bold">
            <i class="bi bi-shield-lock-fill me-2"></i> Admin Dashboard
          </h5>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="offcanvas"
          ></button>
        </div>
        <div class="offcanvas-body d-flex flex-column p-3">
          <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard"
                class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
              >
                <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/pasien"
                class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
              >
                <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/dokter"
                class="nav-link active rounded-3 py-2 px-3 fw-semibold text-white"
              >
                <i class="bi bi-heart-pulse-fill me-3 fs-5"></i> Daftar Dokter
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/admin"
                class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
              >
                <i class="bi bi-person-badge-fill me-3 fs-5"></i> Daftar Admin
              </a>
            </li>
            <li class="nav-item mb-1">
              <a
                href="/adminDashboard/addUser"
                class="nav-link rounded-3 py-2 px-3 fw-semibold text-white"
              >
                <i class="bi bi-person-plus-fill me-3 fs-5"></i> Tambah Pengguna
              </a>
            </li>
          </ul>
          <hr class="border-light border-opacity-25" />
          <div>
            <a href="/adminDashboard/profile" class="sidebar-profile-link">
              <div
                class="profile-avatar bg-white text-success rounded-circle me-2"
              >
                <i class="bi bi-person-badge-fill fs-5"></i>
              </div>
              <div class="text-truncate">
                <div class="fw-bold small text-white text-truncate">
                  <%= locals.userData ? userData.fullname : 'Admin' %>
                </div>
                <div class="profile-email text-white-50 small text-truncate">
                  <%= locals.userData ? userData.username : 'admin' %>
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- KONTEN UTAMA -->
      <div class="flex-grow-1 bg-light d-flex flex-column h-100 overflow-auto">
        <div
          class="bg-white border-bottom px-3 px-md-4 py-3 d-flex justify-content-between align-items-center shadow-sm"
        >
          <div class="d-flex align-items-center">
            <button
              class="btn btn-outline-success d-md-none me-3"
              type="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#mobileSidebar"
            >
              <i class="bi bi-list fs-5"></i>
            </button>
            <h4 class="fw-bold text-dark m-0 fs-5 fs-md-4">
              Tambah Pasien ke Dokter
            </h4>
          </div>
          <div>
            <form action="/logout" method="POST" class="m-0">
              <button
                type="submit"
                class="btn btn-outline-danger btn-sm fw-semibold d-flex align-items-center"
              >
                <i class="bi bi-box-arrow-right me-2"></i> Logout
              </button>
            </form>
          </div>
        </div>

        <div
          class="p-3 p-md-4 flex-grow-1 d-flex flex-column align-items-center form-container-scroll"
        >
          <div
            class="card border-0 shadow-sm rounded-4 p-4 w-100 mb-4"
            style="max-width: 600px"
          >
            <!-- Tombol Kembali -->
            <div class="mb-3">
              <a
                href="/adminDashboard/dokter"
                class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold d-inline-flex align-items-center rounded-3 text-decoration-none"
              >
                <i class="bi bi-arrow-left me-2"></i> Kembali
              </a>
            </div>

            <div class="mb-3">
              <h5 class="fw-bold text-dark mb-1 fs-5">Form Penugasan Pasien</h5>
              <p class="text-muted small mb-0">
                Pilih pasien yang akan dihubungkan ke dokter penanggung jawab.
              </p>
            </div>

            <!-- Informasi Dokter Tujuan -->
            <div
              class="alert alert-success d-flex align-items-center mb-4 py-2 px-3 small"
            >
              <i class="bi bi-heart-pulse-fill fs-5 me-2"></i>
              <div>
                Dokter:
                <strong class="text-uppercase"
                  ><%= targetDokter.fullname %></strong
                >
                (<%= targetDokter.username %>)
              </div>
            </div>

            <!-- Form Submit Add Pasien -->
            <form
              action="/adminDashboard/dokter/add-pasien"
              method="POST"
              onsubmit="return confirm('Yakin ?')"
            >
              <!-- Dokter Id -->
              <input
                type="hidden"
                name="dokterId"
                value="<%= targetDokter.id %>"
              />
              <!-- Custom Searchable Dropdown Pasien -->
              <div class="mb-4">
                <label for="patientSearch" class="form-label fw-semibold small"
                  >Pilih Pasien</label
                >

                <div class="custom-search-dropdown">
                  <input
                    type="text"
                    id="patientSearch"
                    class="form-control"
                    placeholder="Cari nama atau username pasien..."
                    autocomplete="off"
                    required
                  />

                  <input
                    type="hidden"
                    id="pasien_id"
                    name="pasienId"
                    required
                  />

                  <div id="patientDropdownList" class="dropdown-list-box">
                    <% if (getPasienData && getPasienData.length > 0) { %> <%
                    getPasienData.forEach(pasien => { %>
                    <div
                      class="dropdown-item-custom"
                      data-id="<%= pasien.userId %>"
                      data-value="<%= pasien.userId %>"
                      data-text="<%= pasien.fullname %> (<%= pasien.username %>)"
                    >
                      <strong><%= pasien.fullname %></strong> (<%=
                      pasien.username %>)
                    </div>
                    <% }) %> <% } else { %>
                    <div class="no-result">Tidak ada pasien tersedia</div>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-between gap-2 pt-3 border-top">
                <a
                  href="/adminDashboard/dokter"
                  class="btn btn-outline-secondary btn-sm fw-semibold px-4"
                >
                  Batal
                </a>
                <button
                  type="submit"
                  class="btn btn-success btn-sm fw-semibold px-4"
                >
                  <i class="bi bi-person-plus-fill me-1"></i> Tambah Pasien
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    // Script Interaksi Searchable Dropdown
    <script>
      const searchInput = document.getElementById("patientSearch");
      const hiddenInput = document.getElementById("pasien_id");
      const dropdownList = document.getElementById("patientDropdownList");
      const items = dropdownList.querySelectorAll(".dropdown-item-custom");
      const form = hiddenInput.closest("form");

      const noResultMsg =
        dropdownList.querySelector(".no-result") || createNoResultElement();

      function createNoResultElement() {
        const div = document.createElement("div");
        div.className = "no-result";
        div.innerText = "Pasien tidak ditemukan";
        div.style.display = "none";
        dropdownList.appendChild(div);
        return div;
      }

      searchInput.addEventListener("focus", () => {
        dropdownList.style.display = "block";
      });

      searchInput.addEventListener("input", () => {
        const keyword = searchInput.value.toLowerCase();
        let matchCount = 0;

        // Reset pasien yang sebelumnya dipilih
        hiddenInput.value = "";

        dropdownList.style.display = "block";

        items.forEach((item) => {
          const text = item.getAttribute("data-text").toLowerCase();

          if (text.includes(keyword)) {
            item.style.display = "block";
            matchCount++;
          } else {
            item.style.display = "none";
          }
        });

        noResultMsg.style.display = matchCount === 0 ? "block" : "none";
      });

      items.forEach((item) => {
        item.addEventListener("click", () => {
          const id = item.getAttribute("data-id");
          const text = item.getAttribute("data-text");

          searchInput.value = text;
          hiddenInput.value = id;

          dropdownList.style.display = "none";
        });
      });

      // Pastikan pasien sudah dipilih sebelum submit
      form.addEventListener("submit", (e) => {
        if (!hiddenInput.value) {
          e.preventDefault();
          alert("Silakan pilih pasien terlebih dahulu!");
          searchInput.focus();
        }
      });

      document.addEventListener("click", (e) => {
        if (
          !searchInput.contains(e.target) &&
          !dropdownList.contains(e.target)
        ) {
          dropdownList.style.display = "none";
        }
      });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
