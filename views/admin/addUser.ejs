<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><%= title %></title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/style/addUser.css" />
  </head>

  <body>
    <!-- Main Wrapper -->
    <div class="app-layout d-flex">
      <!-- Sidebar -->
      <aside class="sidebar bg-white border-end d-flex flex-column p-3">
        <!-- Logo -->
        <a
          href="/adminDashboard"
          class="d-flex align-items-center mb-4 text-decoration-none text-primary px-2"
        >
          <i class="bi bi-shield-lock-fill fs-3 me-2"></i>
          <span class="fs-5 fw-bold">Telehealth Admin</span>
        </a>

        <hr class="sidebar-divider" />

        <!-- Navigasi -->
        <ul class="nav nav-pills flex-column mb-auto">
          <li class="nav-item mb-1">
            <a
              href="/adminDashboard"
              class="nav-link text-secondary rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i>
              Dashboard
            </a>
          </li>

          <li class="nav-item mb-1">
            <a
              href="/addUser"
              class="nav-link active rounded-3 py-2 px-3 fw-semibold"
              aria-current="page"
            >
              <i class="bi bi-person-plus-fill me-3 fs-5"></i>
              Tambah Pengguna
            </a>
          </li>
        </ul>

        <hr class="sidebar-divider" />

        <!-- Profil Admin -->
        <div class="user-profile d-flex align-items-center px-2">
          <div
            class="profile-avatar bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-2"
          >
            <i class="bi bi-person-badge-fill fs-5"></i>
          </div>

          <div class="profile-info">
            <div class="fw-bold small"><%= userData.fullname %></div>
            <div class="profile-email text-muted small">
              <%= userData.username %>
            </div>
          </div>
        </div>
      </aside>

      <!-- Konten Utama -->
      <main class="main-content flex-grow-1 bg-light p-4">
        <!-- Header -->
        <header
          class="page-header d-flex justify-content-between align-items-center mb-4"
        >
          <div>
            <h4 class="fw-bold text-dark mb-1">Tambah Pengguna</h4>
            <p class="text-muted mb-0">Masukkan informasi pengguna baru.</p>
          </div>

          <a href="/login" class="btn btn-outline-danger fw-semibold">
            <i class="bi bi-box-arrow-right me-2"></i>
            Logout
          </a>
        </header>

        <!-- Form Content -->
        <section class="form-content">
          <form action="/addUser" method="POST" class="user-form">
            <!-- Username -->
            <div class="form-row-custom">
              <label for="username">Username</label>

              <input
                type="text"
                class="form-control"
                id="username"
                name="username"
                placeholder="Masukkan username"
                autocomplete="username"
                required
              />
            </div>

            <!-- Nama Lengkap -->
            <div class="form-row-custom">
              <label for="fullname">Nama Lengkap</label>

              <input
                type="text"
                class="form-control"
                id="fullname"
                name="fullname"
                placeholder="Masukkan nama lengkap"
                autocomplete="name"
                required
              />
            </div>

            <!-- Tanggal Lahir -->
            <div class="form-row-custom">
              <label for="dob">Tanggal Lahir</label>

              <input
                type="date"
                class="form-control"
                id="dob"
                name="dob"
                autocomplete="bday"
                required
              />
            </div>

            <!-- Password -->
            <div class="form-row-custom">
              <label for="password">Password</label>

              <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                placeholder="Masukkan password"
                autocomplete="new-password"
                required
              />
            </div>

            <!-- Konfirmasi Password -->
            <div class="form-row-custom">
              <label for="password2">Konfirmasi Password</label>

              <input
                type="password"
                class="form-control"
                id="password2"
                name="password2"
                placeholder="Ulangi password"
                autocomplete="new-password"
                required
              />
            </div>

            <!-- Status -->
            <div class="form-row-custom">
              <label for="role">Status</label>

              <select class="form-select" id="role" name="role" required>
                <option value="pasien">Pasien</option>
                <option value="dokter">Dokter</option>
                <option value="admin">Admin</option>
              </select>
            </div>

            <!-- Tombol Aksi -->
            <div class="form-actions">
              <button type="submit" class="btn btn-primary fw-semibold">
                <i class="bi bi-person-plus me-2"></i>
                Tambah Pengguna
              </button>
            </div>
          </form>
        </section>
      </main>
    </div>

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
