<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Profil Dokter</title>
    <link rel="stylesheet" href="/style/dokterProfile.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    />
  </head>
  <body class="bg-light">
    <div class="main-container">
      <div class="sidebar p-3 text-white">
        <a
          href="/dokterDashboard"
          class="d-flex align-items-center mb-3 text-decoration-none text-white px-2"
        >
          <i class="bi bi-heart-pulse-fill fs-3 me-2"></i>
          <span class="fs-5 fw-bold">EKG Monitor</span>
        </a>
        <hr class="sidebar-divider" />
        <ul class="nav nav-pills flex-column mb-auto">
          <li class="nav-item mb-1">
            <a
              href="/dokterDashboard"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/dokterDashboard/pasien"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
            </a>
          </li>
        </ul>
        <hr class="sidebar-divider" />
        <div class="pb-2">
          <a
            href="/dokterDashboard/profile"
            class="sidebar-profile-btn text-decoration-none text-white d-flex align-items-center p-2 rounded-3 active"
            style="
              background-color: rgba(255, 255, 255, 0.2);
              border: 1px solid rgba(255, 255, 255, 0.2);
            "
          >
            <div
              class="profile-avatar bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-2"
              style="width: 40px; height: 40px; min-width: 40px"
            >
              <i class="bi bi-person-fill fs-5"></i>
            </div>
            <div class="text-truncate" style="max-width: 170px">
              <div class="fw-bold small text-white text-truncate">
                <%= userData.fullname %>
              </div>
              <div
                class="profile-email text-white-50 small text-truncate"
                style="font-size: 11px"
              >
                <%= userData.username %>
              </div>
            </div>
          </a>
        </div>
      </div>

      <div class="main-content bg-light">
        <div
          class="topbar bg-white border-bottom px-3 px-md-4 py-3 d-flex justify-content-between align-items-center shadow-sm"
        >
          <h4 class="fw-bold text-dark m-0 fs-5 fs-md-4">Profil Dokter</h4>
          <form action="/logout" method="POST" class="m-0">
            <button
              type="submit"
              class="btn btn-outline-danger btn-sm fw-semibold d-flex align-items-center"
            >
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </button>
          </form>
        </div>

        <div class="form-container p-3 p-md-4">
          <div class="mb-3 w-100" style="max-width: 900px">
            <a
              href="/dokterDashboard"
              class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold d-inline-flex align-items-center rounded-3 text-decoration-none"
            >
              <i class="bi bi-arrow-left me-2"></i> Kembali
            </a>
          </div>

          <div
            class="row g-4 w-100 justify-content-center"
            style="max-width: 900px"
          >
            <div class="col-12 col-lg-4">
              <div
                class="card border-0 shadow-sm rounded-4 p-4 text-center h-100"
              >
                <div class="d-flex justify-content-center mb-3">
                  <div
                    class="profile-avatar-large bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center"
                    style="width: 80px; height: 80px; margin: 0 auto"
                  >
                    <i class="bi bi-person-fill fs-1"></i>
                  </div>
                </div>
                <h5 class="fw-bold text-dark mb-3"><%= userData.fullname %></h5>
                <hr class="text-muted opacity-25" />
                <div class="text-start">
                  <span class="text-muted small d-block">Status Akun</span>
                  <span
                    class="badge bg-primary bg-opacity-10 text-primary fw-semibold mt-1 px-3 py-2"
                    ><%= userData.role%></span
                  >
                </div>
              </div>
            </div>

            <div class="col-12 col-lg-8">
              <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                  <i class="bi bi-card-heading text-primary me-2"></i> Detail
                  Informasi Dokter
                </h5>

                <div class="row g-3">
                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Nama Lengkap</span
                      >
                      <strong class="text-dark"
                        ><%= userData.fullname %></strong
                      >
                    </div>
                  </div>
                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Username</span
                      >
                      <strong class="text-dark"><%= userData.username%></strong>
                    </div>
                  </div>
                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Tanggal Lahir</span
                      >
                      <strong class="text-dark"><%= userData.dob %></strong>
                    </div>
                  </div>
                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Jenis Kelamin</span
                      >
                      <strong class="text-dark"><%= userData.gender %></strong>
                    </div>
                  </div>
                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1"
                        >Golongan Darah</span
                      >
                      <strong class="text-dark"
                        ><%= userData.bloodType%></strong
                      >
                    </div>
                  </div>
                  <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-1">
                      <span class="text-muted small d-block mb-1">No Telp</span>
                      <strong class="text-dark"><%= userData.phone %></strong>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
