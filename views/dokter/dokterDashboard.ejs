<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style/dokterDashboard.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    />
  </head>
  <body class="bg-light">
    <div class="main-container">
      <!-- SIDEBAR -->
      <div class="sidebar p-3 text-white">
        <a
          href="/dokterDashboard"
          class="d-flex align-items-center mb-3 text-decoration-none text-white px-2"
        >
          <i class="bi bi-heart-pulse-fill fs-3 me-2"></i>
          <span class="fs-5 fw-bold">EKG Monitor</span>
        </a>
        <hr class="sidebar-divider" />
        <ul class="nav nav-pills flex-column mb-auto">
          <li class="nav-item mb-1">
            <a
              href="/dokterDashboard"
              class="nav-link active rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-bar-chart-line-fill me-3 fs-5"></i> Dashboard
            </a>
          </li>
          <li class="nav-item mb-1">
            <a
              href="/dokterDashboard/pasien"
              class="nav-link text-white rounded-3 py-2 px-3 fw-semibold"
            >
              <i class="bi bi-people-fill me-3 fs-5"></i> Daftar Pasien
            </a>
          </li>
        </ul>
        <hr class="sidebar-divider" />

        <!-- TOMBOL PROFIL BAWAH -->
        <div class="pb-2">
          <a
            href="/dokterDashboard/profile"
            class="sidebar-profile-btn text-decoration-none text-white d-flex align-items-center p-2 rounded-3"
            style="
              background-color: rgba(0, 0, 0, 0.15);
              border: 1px solid rgba(255, 255, 255, 0.2);
            "
          >
            <div
              class="profile-avatar bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-2"
              style="width: 40px; height: 40px; min-width: 40px"
            >
              <i class="bi bi-person-fill fs-5"></i>
            </div>
            <div class="text-truncate" style="max-width: 170px">
              <div class="fw-bold small text-white text-truncate">
                <%= userData ? userData.fullname : 'Dokter' %>
              </div>
              <div
                class="profile-email text-white-50 small text-truncate"
                style="font-size: 11px"
              >
                <%= userData ? userData.username : '' %>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- KONTEN UTAMA -->
      <div class="main-content bg-light">
        <!-- TOPBAR -->
        <div
          class="topbar bg-white border-bottom px-3 px-md-4 py-3 d-flex justify-content-between align-items-center shadow-sm"
        >
          <div class="d-flex align-items-center">
            <h4 class="fw-bold text-dark m-0 fs-5 fs-md-4">Dashboard Dokter</h4>
          </div>
          <div>
            <form action="/logout" method="POST" class="m-0">
              <button
                type="submit"
                class="btn btn-outline-danger btn-sm fw-semibold d-flex align-items-center"
              >
                <i class="bi bi-box-arrow-right me-2"></i> Logout
              </button>
            </form>
          </div>
        </div>

        <!-- ISI DASHBOARD -->
        <div class="form-container p-3 p-md-4">
          <div class="w-100" style="max-width: 1100px">
            <!-- BANNER SELAMAT DATANG -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
              <h5 class="fw-bold text-dark mb-1">
                Selamat Datang, <%= userData ? userData.fullname : 'Dokter' %>
              </h5>
              <p class="text-muted small mb-0">
                Berikut adalah ringkasan aktivitas pemantauan EKG pasien Anda
                hari ini.
              </p>
            </div>

            <!-- KARTU STATISTIK RINGKASAN -->
            <div class="row g-3 mb-4">
              <div class="col-12 col-md-4">
                <div
                  class="card border-0 shadow-sm rounded-4 p-4 h-100 d-flex flex-row align-items-center justify-content-between"
                >
                  <div>
                    <span class="text-muted small fw-bold d-block mb-1"
                      >TOTAL PASIEN</span
                    >
                    <div class="fs-3 fw-bold text-dark">
                      1 <span class="fs-6 text-muted fw-normal">Orang</span>
                    </div>
                  </div>
                  <div
                    class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center"
                    style="width: 55px; height: 55px"
                  >
                    <i class="bi bi-people fs-4"></i>
                  </div>
                </div>
              </div>

              <div class="col-12 col-md-4">
                <div
                  class="card border-0 shadow-sm rounded-4 p-4 h-100 d-flex flex-row align-items-center justify-content-between"
                >
                  <div>
                    <span class="text-muted small fw-bold d-block mb-1"
                      >PERANGKAT ONLINE</span
                    >
                    <div class="fs-3 fw-bold text-success">
                      0 <span class="fs-6 text-muted fw-normal">Aktif</span>
                    </div>
                  </div>
                  <div
                    class="bg-success bg-opacity-10 text-success rounded-circle p-3 d-flex align-items-center justify-content-center"
                    style="width: 55px; height: 55px"
                  >
                    <i class="bi bi-wifi fs-4"></i>
                  </div>
                </div>
              </div>

              <div class="col-12 col-md-4">
                <div
                  class="card border-0 shadow-sm rounded-4 p-4 h-100 d-flex flex-row align-items-center justify-content-between"
                >
                  <div>
                    <span class="text-muted small fw-bold d-block mb-1"
                      >STATUS SISTEM</span
                    >
                    <div class="fs-5 fw-bold text-dark mt-1">
                      <span
                        class="badge bg-success bg-opacity-10 text-success px-2 py-1"
                        >Normal</span
                      >
                    </div>
                  </div>
                  <div
                    class="bg-info bg-opacity-10 text-info rounded-circle p-3 d-flex align-items-center justify-content-center"
                    style="width: 55px; height: 55px"
                  >
                    <i class="bi bi-shield-check fs-4"></i>
                  </div>
                </div>
              </div>
            </div>

            <!-- TABEL PASIEN PRIORITAS -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
              <div
                class="d-flex justify-content-between align-items-center mb-3"
              >
                <h5 class="fw-bold text-dark m-0">Pasien Dalam Pemantauan</h5>
                <a
                  href="/dokterDashboard/pasien"
                  class="btn btn-outline-primary btn-sm fw-semibold text-decoration-none"
                  >Lihat Semua</a
                >
              </div>
              <div class="table-responsive">
                <table class="table align-middle mb-0">
                  <thead>
                    <tr>
                      <th class="py-3">No.</th>
                      <th class="py-3">Username</th>
                      <th class="py-3">Nama Lengkap</th>
                      <th class="py-3">Status Perangkat</th>
                      <th class="py-3 text-center">Aksi Pantau</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>1</td>
                      <td>Kemal123</td>
                      <td>Kemal Palevi</td>
                      <td>
                        <span class="badge bg-secondary text-white px-2 py-1"
                          >Offline</span
                        >
                      </td>
                      <td class="text-center">
                        <a
                          href="/dokterDashboard/pasien"
                          class="btn btn-primary btn-sm px-3 fw-semibold text-decoration-none"
                          >Buka Pantau</a
                        >
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
